# Copy to .env and fill in. .env is gitignored and never copied into images.

# --- Claude (agents and the generated apps' question answering) ---
ANTHROPIC_API_KEY=
# Model the five agents use
FACTORY_MODEL=claude-opus-5-5
# Generated apps' governed AI layer
INSIGHTS_LLM_PROVIDER=anthropic
INSIGHTS_LLM_MODEL=claude-sonnet-5-5

# --- PostgreSQL: staging database for generated apps ---
# The user needs CREATEDB and CREATEROLE (the factory creates database `factory`, one schema per app,
# and one role per persona). docker-compose.yml starts a matching server on port 5440.
PG_HOST=localhost
PG_PORT=5440
PG_USER=factory
PG_PASSWORD=factory_dev_pw
FACTORY_PG_DB=factory

# --- Neo4j: knowledge graph (optional; the glossary works without it) ---
NEO4J_URI=neo4j://127.0.0.1:7690
NEO4J_USER=neo4j
NEO4J_PASSWORD=factory_dev_pw

# --- Azure deployment (agent 5, after gate C) ---
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=
AZURE_RESOURCE_GROUP=
AZURE_ACR_NAME=
PG_ADMIN_PASSWORD=
