{
  "signals": [
    {
      "id": "SIG-CIO-1",
      "title": "Risk Model Under-Ranks Frontier Patients",
      "severity": "critical",
      "description": "Frontier ZIPs rank 18% lower than similar town members; 57 high-need miss the top 300.",
      "metric": "18% gap · 57 missing",
      "sources": [
        "Model Card",
        "HRSA FORHP"
      ],
      "chip": "Show me the subgroup result",
      "primary": true
    },
    {
      "id": "SIG-CIO-2",
      "title": "Claims Feed Lag",
      "severity": "warning",
      "description": "Claims arrive 45 days late. The near real-time ADT feed can fill the ED gap.",
      "metric": "45 days · ADT under 1 hour",
      "sources": [
        "Pipeline Monitor",
        "HIE ADT"
      ],
      "chip": "How stale is our data?"
    },
    {
      "id": "SIG-CIO-3",
      "title": "Social Needs Data Coverage",
      "severity": "warning",
      "description": "Only 38% of members screened, which limits transport and housing signals.",
      "metric": "38% screened",
      "sources": [
        "Screening Tool"
      ],
      "chip": "Show me social needs coverage"
    }
  ],
  "kpis": [
    {
      "id": "sources",
      "label": "Connected Sources",
      "value": "19 public + 6 synthetic",
      "source": "Data Sources registry",
      "icon": "database",
      "tone": "neutral",
      "chip": "How fresh is each data source?"
    },
    {
      "id": "claimsLag",
      "label": "Claims Lag",
      "value": "45 days",
      "source": "Pipeline monitor",
      "icon": "clock",
      "tone": "warning",
      "chip": "How stale is our data?"
    },
    {
      "id": "adtLag",
      "label": "ADT Lag",
      "value": "Under 1 hour",
      "source": "HIE feed",
      "icon": "timer",
      "tone": "good"
    },
    {
      "id": "subgroup",
      "label": "Subgroup Check",
      "value": "Failed",
      "detail": "Frontier ZIPs",
      "source": "Model card",
      "icon": "shield-alert",
      "tone": "critical",
      "chip": "Show me the subgroup result"
    },
    {
      "id": "missing",
      "label": "Members Missing from Top 300",
      "value": "57",
      "source": "Subgroup check",
      "icon": "users",
      "tone": "critical",
      "chip": "Show the 57 members"
    },
    {
      "id": "social",
      "label": "Social Needs Coverage",
      "value": "38%",
      "source": "Screening tool",
      "icon": "clipboard-check",
      "tone": "warning",
      "chip": "Show me social needs coverage"
    },
    {
      "id": "freshness",
      "label": "Data Freshness",
      "value": "Q3 claims, ADT today",
      "source": "All views",
      "icon": "calendar-clock",
      "tone": "neutral"
    }
  ],
  "steps": {
    "cio_brief": {
      "step": 1,
      "capability": "Proactive Intelligence",
      "ai": "Good morning, Raj. Before the care team starts outreach, one thing needs your attention: the impactability model failed its subgroup check.",
      "points": [
        "Frontier ZIPs rank 18% lower than similar town members; 57 high-need frontier members miss the top 300.",
        "Also: the usual 45-day claims lag and low social needs coverage."
      ],
      "sources": [
        "Model Card",
        "Claims",
        "EHR (FHIR)",
        "HIE ADT",
        "USDA RUCC",
        "HRSA FORHP Rural Areas"
      ],
      "chips": [
        "Show me the subgroup result",
        "How stale is our data?",
        "Show me social needs coverage"
      ],
      "next": "Show me the subgroup result",
      "viz": [
        "v_model_card",
        "v_freshness"
      ]
    },
    "cio_subgroup": {
      "step": 2,
      "capability": "Anomaly Detection",
      "asks": [
        "Show me the subgroup result",
        "Did the risk model pass its subgroup check?"
      ],
      "ai": "The model uses past utilization as a main input, so frontier members are ranked lower in every condition group.",
      "points": [
        "Frontier members have 31% fewer primary care visits: a 74-minute median drive, and 190 have no broadband.",
        "Fewer visits mean fewer claims, which the model reads as lower risk.",
        "Same conditions and labs, ranked lower in every group: the known cost-as-proxy bias."
      ],
      "sources": [
        "Model Card",
        "Claims",
        "EHR (FHIR)",
        "Travel Time (OpenStreetMap)",
        "FCC Broadband",
        "Census ZCTA"
      ],
      "chips": [
        "What changes if we fix it?",
        "Which features cause it?",
        "Show the 57 members"
      ],
      "next": "What changes if we fix it?",
      "launch": {
        "workbench": "modelGovernance",
        "filter": "subgroup",
        "label": "Model Governance",
        "detail": "on the subgroup check"
      },
      "viz": [
        "v_subgroup",
        "v_scatter",
        "v_zip_map",
        "v_launch_mg"
      ]
    },
    "cio_fix": {
      "step": 3,
      "capability": "Predictive Intelligence",
      "asks": [
        "What changes if we fix it?"
      ],
      "ai": "Access-adjusted features bring the frontier gap from 18% to 3%, inside the release threshold.",
      "points": [
        "57 frontier members enter the top 300; 57 lower-need town members leave.",
        "41 of the 57 are in the BP denominator, which helps the quality gate.",
        "Ranking accuracy holds steady."
      ],
      "sources": [
        "Model Card",
        "HRSA HPSA",
        "FCC Broadband",
        "Travel Time (OpenStreetMap)",
        "eCQM Engine"
      ],
      "chips": [
        "Generate the governance packet",
        "Notify Dr. Castellanos",
        "Set a data freshness banner"
      ],
      "next": "Generate the governance packet",
      "action": "preview:fix",
      "viz": [
        "v_before_after",
        "v_swaps"
      ]
    },
    "cio_packet": {
      "step": 4,
      "capability": "Automated Action",
      "asks": [
        "Generate the governance packet"
      ],
      "ai": "Here is the governance packet: the updated model card, the subgroup results before and after, the feature change log and a sign-off page for you and Dr. Castellanos.",
      "points": [
        "Until you sign, the care team sees the current ranking with a pending-fix banner.",
        "Also drafted: ADT-based ED alerts to cover the 45-day claims lag."
      ],
      "sources": [
        "Model Card",
        "Data Quality Monitor",
        "HIE ADT"
      ],
      "chips": [
        "Sign off and release",
        "Send to Dr. Castellanos for co-sign",
        "Request ADT alerts"
      ],
      "next": "Sign off and release",
      "viz": [
        "v_packet",
        "v_banner"
      ]
    },
    "cio_signoff": {
      "capability": "Automated Action",
      "asks": [
        "Sign off and release"
      ],
      "ai": "Signed: the release now waits only on Dr. Castellanos's co-sign, and the care team keeps the pending-fix banner until then.",
      "sources": [
        "Model Card"
      ],
      "chips": [
        "Send to Dr. Castellanos for co-sign",
        "Request ADT alerts",
        "How fresh is each data source?"
      ],
      "action": "sign:cio",
      "viz": [
        "v_signoff"
      ]
    },
    "cio_cosign": {
      "capability": "Automated Action",
      "asks": [
        "Send to Dr. Castellanos for co-sign",
        "Notify Dr. Castellanos"
      ],
      "ai": "Sent to Dr. Castellanos for co-sign in Model Governance.",
      "sources": [
        "Model Card"
      ],
      "chips": [
        "Sign off and release",
        "Request ADT alerts"
      ],
      "next": "Sign off and release",
      "action": "request:cosign",
      "viz": [
        "v_signoff"
      ]
    },
    "cio_adt": {
      "capability": "Automated Action",
      "asks": [
        "Request ADT alerts"
      ],
      "ai": "Drafted: a request to route HIE ADT events into the ED signal, so new ED visits show the same day.",
      "sources": [
        "HIE ADT",
        "Pipeline Monitor"
      ],
      "chips": [
        "Sign off and release",
        "How fresh is each data source?"
      ],
      "next": "Sign off and release",
      "viz": [
        "v_adt"
      ]
    },
    "cio_stale": {
      "capability": "Friction Observability",
      "asks": [
        "How stale is our data?",
        "How fresh is each data source?"
      ],
      "ai": "Claims trail by 45 days; the ADT feed is under an hour old and can fill the ED gap.",
      "sources": [
        "Pipeline Monitor",
        "HIE ADT",
        "Data Sources Registry"
      ],
      "chips": [
        "Request ADT alerts",
        "Show me the subgroup result",
        "Open Data Sources"
      ],
      "next": "Show me the subgroup result",
      "viz": [
        "v_feeds"
      ]
    },
    "cio_social": {
      "capability": "Friction Observability",
      "asks": [
        "Show me social needs coverage",
        "Which members are missing social needs screening?"
      ],
      "ai": "Only 38% of members have a social needs screening, which limits transport and housing signals.",
      "sources": [
        "Screening Tool",
        "EHR (FHIR)"
      ],
      "chips": [
        "Show me the subgroup result",
        "How fresh is each data source?"
      ],
      "next": "Show me the subgroup result",
      "viz": [
        "v_social"
      ]
    },
    "cio_features": {
      "capability": "Anomaly Detection",
      "asks": [
        "Which features cause it?"
      ],
      "ai": "Prior-year cost and primary care visits carry 41 percent of the weight, and both read thin claims history as low risk.",
      "sources": [
        "Model Card"
      ],
      "chips": [
        "What changes if we fix it?",
        "Show the 57 members"
      ],
      "next": "What changes if we fix it?",
      "viz": [
        "v_features"
      ]
    },
    "cio_57": {
      "capability": "Converged Conversation",
      "asks": [
        "Show the 57 members"
      ],
      "ai": "These are the 57 high-need frontier members the current model leaves out of the top 300, de-identified.",
      "sources": [
        "Model Card",
        "Claims",
        "EHR (FHIR)"
      ],
      "chips": [
        "What changes if we fix it?",
        "Generate the governance packet"
      ],
      "next": "What changes if we fix it?",
      "viz": [
        "v_swaps_in"
      ]
    },
    "cio_banner": {
      "capability": "Automated Action",
      "asks": [
        "Set a data freshness banner"
      ],
      "ai": "Done: every view now shows that claims run through Q3 with a 45-day lag and ADT is current to today.",
      "sources": [
        "Pipeline Monitor"
      ],
      "chips": [
        "Generate the governance packet",
        "How fresh is each data source?"
      ],
      "next": "Generate the governance packet",
      "action": "banner:on",
      "viz": [
        "v_freshness_banner"
      ]
    },
    "cio_card": {
      "capability": "Converged Conversation",
      "asks": [
        "Show the model card"
      ],
      "ai": "The impactability score ranks rising-risk members for outreach, and version 1.3 failed its subgroup check on frontier ZIP codes.",
      "sources": [
        "Model Card"
      ],
      "chips": [
        "Show me the subgroup result",
        "Which features cause it?"
      ],
      "next": "Show me the subgroup result",
      "viz": [
        "v_model_card"
      ]
    },
    "cio_public": {
      "capability": "Converged Conversation",
      "asks": [
        "What public data feeds the county view?"
      ],
      "ai": "Six public sources feed the county view: PLACES, SVI, HRSA shortage areas, FCC broadband, USDA rural codes and Census boundaries.",
      "sources": [
        "Data Sources Registry"
      ],
      "chips": [
        "How fresh is each data source?",
        "Open Data Sources"
      ],
      "next": "How fresh is each data source?",
      "viz": [
        "v_public"
      ]
    },
    "cio_match": {
      "capability": "Friction Observability",
      "asks": [
        "Show records that failed patient matching"
      ],
      "ai": "214 records failed patient matching this month, and they are queued for review rather than dropped.",
      "sources": [
        "Data Quality Monitor",
        "MCO Eligibility",
        "EHR (FHIR)"
      ],
      "chips": [
        "How fresh is each data source?",
        "Show me the subgroup result"
      ],
      "next": "Show me the subgroup result",
      "viz": [
        "v_match"
      ]
    },
    "cio_open_ds": {
      "capability": "Converged Conversation",
      "asks": [
        "Open Data Sources"
      ],
      "ai": "Opening Data Sources, where you can check each feed's freshness and select one to ask about it.",
      "sources": [
        "Data Sources Registry"
      ],
      "chips": [
        "How stale is our data?",
        "Show me the subgroup result"
      ],
      "launch": {
        "workbench": "dataSources",
        "filter": "all",
        "label": "Data Sources",
        "detail": "every source with freshness and label",
        "auto": true
      },
      "viz": [
        "v_launch_ds"
      ]
    },
    "cio_ctx_feature": {
      "capability": "Anomaly Detection",
      "asks": [
        "Explain this feature"
      ],
      "ai": "Here is what this model feature reads and how it treats frontier members.",
      "sources": [
        "Model Card"
      ],
      "chips": [
        "What changes if we fix it?",
        "Which features cause it?"
      ],
      "viz": [
        "v_ctx_feature"
      ]
    },
    "cio_ctx_source": {
      "capability": "Friction Observability",
      "asks": [
        "Explain this source"
      ],
      "ai": "Here is what this source provides, how fresh it is and what reads it.",
      "sources": [
        "Data Sources Registry"
      ],
      "chips": [
        "How fresh is each data source?",
        "What public data feeds the county view?"
      ],
      "viz": [
        "v_ctx_source"
      ]
    },
    "__default__": {
      "ai": "I can answer on the risk model and its subgroup check, data freshness, social needs coverage, patient matching and the public sources.",
      "sources": [],
      "chips": [
        "Show me the subgroup result",
        "How stale is our data?",
        "Show the model card"
      ]
    }
  },
  "queries": [
    "Show the model card",
    "Did the risk model pass its subgroup check?",
    "How fresh is each data source?",
    "Which members are missing social needs screening?",
    "What public data feeds the county view?",
    "Show records that failed patient matching",
