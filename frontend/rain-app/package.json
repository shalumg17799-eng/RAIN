{
  "name": "rain",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scaffold:persona": "node scripts/scaffold-persona.mjs",
    "scaffold:market": "node scripts/scaffold-market.mjs",
    "scaffold:client": "node scripts/scaffold-client.mjs",
    "scaffold:component": "node scripts/scaffold-component.mjs",
    "remove": "node scripts/remove.mjs",
    "find:component": "node scripts/find-component.mjs",
    "preview": "vite preview",
    "audit:standard": "node scripts/standard-audit.mjs",
    "check:registration": "node scripts/check-registration.mjs --all",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "check": "npm run typecheck && npm test && npm run lint:ratchet && npm run catalog -- --check && npm run audit:standard && npm run check:registration && npm run build",
    "catalog": "vite-node --config scripts/vite-node.config.js scripts/export-catalog.ts",
    "mock-api": "vite-node --config scripts/vite-node.config.js scripts/mock-api.ts",
    "fixtures:backend": "vite-node --config scripts/vite-node.config.js scripts/export-backend-fixtures.ts",
    "visual": "node scripts/visual.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "overrides": {
    "js-cookie": "^3.0.8"
  }
}
