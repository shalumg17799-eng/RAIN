{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dif.radiant.digital/contracts/reconciliation.v1.json",
  "title": "reconciliation",
  "type": "object",
  "properties": {
    "resolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept": {
            "type": "string"
          },
          "table": {
            "type": [
              "string",
              "null"
            ]
          },
          "column": {
            "type": [
              "string",
              "null"
            ]
          },
          "asset_status": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "concept"
        ]
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "item",
          "kind",
          "reason"
        ]
      }
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "resolvable": {
            "type": "boolean"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "resolvable"
        ]
      }
    },
    "readiness": {
      "type": "string",
      "enum": [
        "ready",
        "partial",
        "blocked"
      ]
    },
    "score": {
      "type": "number"
    },
    "explanation": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "resolved",
    "unresolved",
    "readiness",
    "score"
  ]
}
