{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dif.radiant.digital/contracts/semantic-mappings.v1.json",
  "title": "semantic-mappings",
  "type": "object",
  "properties": {
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string"
          },
          "table": {
            "type": "string"
          },
          "attribute": {
            "type": [
              "string",
              "null"
            ]
          },
          "column": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number"
          },
          "method": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "entity",
          "table",
          "confidence",
          "method"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "unmapped_entity",
              "unmapped_table",
              "unmapped_attribute"
            ]
          },
          "name": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "name"
        ]
      }
    },
    "confidence": {
      "type": "number"
    }
  },
  "required": [
    "mappings",
    "gaps",
    "confidence"
  ]
}
