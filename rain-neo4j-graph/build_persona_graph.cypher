// --- Cascade root event + branches (one closure -> five branches, a real tree) ---
MERGE (r:ClosureEvent {title: 'Battle Mountain closure', date: '2026-03-01'}) SET r.description = 'The labor and delivery unit at Battle Mountain Critical Access Hospital suspended obstetric services due to staffing loss. The nearest delivering hospital is now 115 miles away.';
MERGE (b:CascadeBranch {id: 'maternal-access'}) SET b.label = 'Maternal access', b.metric = '58% of women >60 mi from OB';
MATCH (b:CascadeBranch {id: 'maternal-access'}), (r:ClosureEvent {title: 'Battle Mountain closure'}) MERGE (b)-[:CAUSED_BY]->(r);
MATCH (b:CascadeBranch {id: 'maternal-access'}), (c:Concept {concept_id: 'C-ACCESS-BARRIER'}) MERGE (b)-[:REPRESENTS]->(c);
MATCH (b:CascadeBranch {id: 'maternal-access'}), (p:Persona {id: 'maria'}) MERGE (b)-[:AFFECTS]->(p);
MERGE (b:CascadeBranch {id: 'chronic-continuity'}) SET b.label = 'Chronic continuity', b.metric = '64% of avoidable ED from affected panels';
MATCH (b:CascadeBranch {id: 'chronic-continuity'}), (r:ClosureEvent {title: 'Battle Mountain closure'}) MERGE (b)-[:CAUSED_BY]->(r);
MATCH (b:CascadeBranch {id: 'chronic-continuity'}), (c:Concept {concept_id: 'C-EPISODE'}) MERGE (b)-[:REPRESENTS]->(c);
MATCH (b:CascadeBranch {id: 'chronic-continuity'}), (p:Persona {id: 'sarah'}) MERGE (b)-[:AFFECTS]->(p);
MERGE (b:CascadeBranch {id: 'ed-utilization'}) SET b.label = 'ED utilization', b.metric = '+19% avoidable ED visits';
MATCH (b:CascadeBranch {id: 'ed-utilization'}), (r:ClosureEvent {title: 'Battle Mountain closure'}) MERGE (b)-[:CAUSED_BY]->(r);
MATCH (b:CascadeBranch {id: 'ed-utilization'}), (c:Concept {concept_id: 'C-RISK-SIGNAL'}) MERGE (b)-[:REPRESENTS]->(c);
MATCH (b:CascadeBranch {id: 'ed-utilization'}), (p:Persona {id: 'priya'}) MERGE (b)-[:AFFECTS]->(p);
MERGE (b:CascadeBranch {id: 'transport-strain'}) SET b.label = 'Transport strain', b.metric = '+210% long-distance transport demand';
MATCH (b:CascadeBranch {id: 'transport-strain'}), (r:ClosureEvent {title: 'Battle Mountain closure'}) MERGE (b)-[:CAUSED_BY]->(r);
MATCH (b:CascadeBranch {id: 'transport-strain'}), (c:Concept {concept_id: 'C-ACCESS-BARRIER'}) MERGE (b)-[:REPRESENTS]->(c);
MATCH (b:CascadeBranch {id: 'transport-strain'}), (p:Persona {id: 'james'}) MERGE (b)-[:AFFECTS]->(p);
MERGE (b:CascadeBranch {id: 'telehealth-equity'}) SET b.label = 'Telehealth equity', b.metric = '240 elevated-risk in dead zones';
MATCH (b:CascadeBranch {id: 'telehealth-equity'}), (r:ClosureEvent {title: 'Battle Mountain closure'}) MERGE (b)-[:CAUSED_BY]->(r);
MATCH (b:CascadeBranch {id: 'telehealth-equity'}), (c:Concept {concept_id: 'C-ACCESS-BARRIER'}) MERGE (b)-[:REPRESENTS]->(c);
MATCH (b:CascadeBranch {id: 'telehealth-equity'}), (p:Persona {id: 'priya'}) MERGE (b)-[:AFFECTS]->(p);

