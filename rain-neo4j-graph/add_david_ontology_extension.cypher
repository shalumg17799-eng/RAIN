// David's ontology extension, built by Shalini's team -- 8 new
// data-quality concepts (Data Source, Data Quality Issue, Referential
// Integrity, Completeness, Conformance, Freshness, Data Lineage,
// Lifecycle Event), closing the gap where 5 of David's 8 real questions
// returned zero concept match. Extracted from her full build_graph.cypher
// (which also regenerates the original 2-domain USSFCU content) -- this
// file is only the new, RAIN-only addition, safe to run on our
// already-cleaned, 5-concept graph without reintroducing USSFCU.
//
// Every mapping below carries her own real row counts and honest
// confidence ratings (auto-eligible vs needs-review) -- not re-verified
// independently here, taken as her team's tested work.

MERGE (cC_DATA_SOURCE:Concept {concept_id: 'C-DATA-SOURCE'}) SET cC_DATA_SOURCE.name = 'Data Source', cC_DATA_SOURCE.definition = 'An integration endpoint -- feed, interface, connector or batch extract -- through which records from an operational system enter the platform, monitored as one unit for delivery and quality (an EHR interface or device platform; a core-banking batch or loan-origination export). The business-level feed people ask about, not the :SourceSystem node the ontology maps fields to.', cC_DATA_SOURCE.status = 'proposed', cC_DATA_SOURCE.proposed_by_domain = 'RAIN';
MERGE (cC_DATA_QUALITY_ISSUE:Concept {concept_id: 'C-DATA-QUALITY-ISSUE'}) SET cC_DATA_QUALITY_ISSUE.name = 'Data Quality Issue', cC_DATA_QUALITY_ISSUE.definition = 'A detected occurrence of data failing a quality expectation: dated, typed by the quality dimension it breaks (referential integrity, completeness, conformance, freshness), attributed to the source where it was found and the kind of entity it affects, and sized by the records affected. Covers issue-log entries and the record-level defects behind them. It describes the data, not the person or entity the data is about.', cC_DATA_QUALITY_ISSUE.status = 'proposed', cC_DATA_QUALITY_ISSUE.proposed_by_domain = 'RAIN';
MERGE (cC_REFERENTIAL_INTEGRITY:Concept {concept_id: 'C-REFERENTIAL-INTEGRITY'}) SET cC_REFERENTIAL_INTEGRITY.name = 'Referential Integrity', cC_REFERENTIAL_INTEGRITY.definition = 'The data-quality dimension that every reference a record holds to another entity resolves to one valid, current target, and that systems or crosswalks holding the same reference agree. Violations are orphaned references to a retired, merged or re-keyed entity, and crosswalk mismatches that still name the old target. The referenced entity type (provider, member, loan officer, account) is a parameter, not part of the concept.', cC_REFERENTIAL_INTEGRITY.status = 'proposed', cC_REFERENTIAL_INTEGRITY.proposed_by_domain = 'RAIN';
MERGE (cC_COMPLETENESS:Concept {concept_id: 'C-COMPLETENESS'}) SET cC_COMPLETENESS.name = 'Completeness', cC_COMPLETENESS.definition = 'The data-quality dimension that expected records or values are actually present, measured as received over expected for a source, population or time window (device readings transmitted, required disclosures on file, survey responses captured). Distinct from process timeliness and from cohort-attribution coverage.', cC_COMPLETENESS.status = 'proposed', cC_COMPLETENESS.proposed_by_domain = 'RAIN';
MERGE (cC_CONFORMANCE:Concept {concept_id: 'C-CONFORMANCE'}) SET cC_CONFORMANCE.name = 'Conformance', cC_CONFORMANCE.definition = 'The data-quality dimension that records conform to the format, code set or exchange standard they must follow, measured as the share passing validation. The standard is a parameter: FHIR or HL7 v2 in healthcare; MISMO, HMDA LAR edits, NACHA or ISO 20022 in financial services.', cC_CONFORMANCE.status = 'proposed', cC_CONFORMANCE.proposed_by_domain = 'RAIN';
MERGE (cC_FRESHNESS:Concept {concept_id: 'C-FRESHNESS'}) SET cC_FRESHNESS.name = 'Freshness', cC_FRESHNESS.definition = 'The timeliness dimension of data quality: how current a source\'s most recently loaded data is, expressed as ingestion or pipeline lag against an expected refresh cadence or service level (on-time vs delayed). Anything computed from a stale source is itself stale.', cC_FRESHNESS.status = 'proposed', cC_FRESHNESS.proposed_by_domain = 'RAIN';
MERGE (cC_DATA_LINEAGE:Concept {concept_id: 'C-DATA-LINEAGE'}) SET cC_DATA_LINEAGE.name = 'Data Lineage', cC_DATA_LINEAGE.definition = 'The dependency path from source records to the derived outputs built on them -- risk scores, cohorts, attributions, reports, regulatory test results -- and to the owners of those outputs. Used for impact analysis: which downstream outputs a data-quality issue makes suspect.', cC_DATA_LINEAGE.status = 'proposed', cC_DATA_LINEAGE.proposed_by_domain = 'RAIN';
MERGE (cC_LIFECYCLE_EVENT:Concept {concept_id: 'C-LIFECYCLE-EVENT'}) SET cC_LIFECYCLE_EVENT.name = 'Lifecycle Event', cC_LIFECYCLE_EVENT.definition = 'A dated change in the operating state of an entity that other records depend on -- closure, deactivation, termination, merge, or reassignment to a successor (a facility closure or practitioner deactivation; a branch closure, loan-officer departure or account merge). It anchors before/after comparisons and is a common root cause of referential-integrity breaks.', cC_LIFECYCLE_EVENT.status = 'proposed', cC_LIFECYCLE_EVENT.proposed_by_domain = 'RAIN';

// --- Source systems + fields + MAPS_TO edges (RAIN domain) -- previously unmapped columns on EXISTING concepts ---
MERGE (s_73481:SourceSystem {name: 'ProviderReferenceIssue'}) MERGE (f_RAIN_64902:SourceField {name: 'old_provider_id', source_system: 'ProviderReferenceIssue'}) MERGE (f_RAIN_64902)-[:BELONGS_TO]->(s_73481);
MATCH (c:Concept {concept_id: 'C-PROVIDER'}), (f:SourceField {name: 'old_provider_id', source_system: 'ProviderReferenceIssue'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'needs-review', r.note = 'Provider id held by a broken record (PRV-001 737 / PRV-002 683). Name differs from Provider.provider_id -- same pattern as ClaimEncounter.rendering_provider_id.';
MERGE (s_99409:SourceSystem {name: 'ChronicConditionEnrollment'}) MERGE (f_RAIN_73663:SourceField {name: 'assigned_provider_id', source_system: 'ChronicConditionEnrollment'}) MERGE (f_RAIN_73663)-[:BELONGS_TO]->(s_99409);
MATCH (c:Concept {concept_id: 'C-PROVIDER'}), (f:SourceField {name: 'assigned_provider_id', source_system: 'ChronicConditionEnrollment'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'needs-review', r.note = 'Provider attribution under another column name. 49 enrollments point at deactivated PRV-001/002 (49 patients, vs 46 reachable through claims).';
