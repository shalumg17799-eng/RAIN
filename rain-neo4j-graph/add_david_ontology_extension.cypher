MATCH (c:Concept {concept_id: 'C-LIFECYCLE-EVENT'}), (f:SourceField {name: 'reassigned_to_provider_id', source_system: 'Provider'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'needs-review', r.note = 'Successor at deactivation: PRV-001->PRV-010 (Cardiology), PRV-002->PRV-011 (OB). Looks swapped; only 4 of the 49 affected patients have it as primary.';

// --- Concept-to-concept relationships (ABOUT / CAUSES are domain-scoped: MERGE key includes domain) ---
MATCH (a:Concept {concept_id: 'C-DATA-QUALITY-ISSUE'}), (b:Concept {concept_id: 'C-REFERENTIAL-INTEGRITY'}) MERGE (a)-[r:HAS_DIMENSION]->(b) SET r.confidence_category = 'auto-eligible', r.note = 'DataQualityEvent.event_type = unresolved_reference (DQE-PROV-RECON, 1,240 records).';
MATCH (a:Concept {concept_id: 'C-DATA-QUALITY-ISSUE'}), (b:Concept {concept_id: 'C-COMPLETENESS'}) MERGE (a)-[r:HAS_DIMENSION]->(b) SET r.confidence_category = 'auto-eligible', r.note = 'DataQualityEvent.event_type = missing_transmission (DQE-RPM-GAP).';
MATCH (a:Concept {concept_id: 'C-DATA-QUALITY-ISSUE'}), (b:Concept {concept_id: 'C-CONFORMANCE'}) MERGE (a)-[r:HAS_DIMENSION]->(b) SET r.confidence_category = 'auto-eligible', r.note = 'DataQualityEvent.event_type = conformance_error (DQE-FHIR-CONFORMANCE).';
MATCH (a:Concept {concept_id: 'C-DATA-QUALITY-ISSUE'}), (b:Concept {concept_id: 'C-FRESHNESS'}) MERGE (a)-[r:HAS_DIMENSION]->(b) SET r.confidence_category = 'needs-review', r.note = 'No event row today: the 2 delayed feeds appear only in DataSourceFeed.ingestion_lag_status.';
MATCH (a:Concept {concept_id: 'C-DATA-QUALITY-ISSUE'}), (b:Concept {concept_id: 'C-DATA-SOURCE'}) MERGE (a)-[r:DETECTED_ON]->(b) SET r.confidence_category = 'needs-review', r.note = 'DataQualityEvent.source_system; only 1 of 4 values is a feed name, the rest are monitors or services.';
MATCH (a:Concept {concept_id: 'C-REFERENTIAL-INTEGRITY'}), (b:Concept {concept_id: 'C-PROVIDER'}) MERGE (a)-[r:ABOUT {domain: 'RAIN'}]->(b) SET r.confidence_category = 'needs-review', r.note = 'ProviderReferenceIssue.old_provider_id; DQE-PROV-RECON related_entity_type = provider. In USSFCU the same dimension would be ABOUT Constituent (member_id).';
MATCH (a:Concept {concept_id: 'C-COMPLETENESS'}), (b:Concept {concept_id: 'C-CONSTITUENT'}) MERGE (a)-[r:ABOUT {domain: 'RAIN'}]->(b) SET r.confidence_category = 'needs-review', r.note = 'Expected readings are per patient (RPMReading.patient_id); DQE-RPM-GAP related_entity_type = patient.';
