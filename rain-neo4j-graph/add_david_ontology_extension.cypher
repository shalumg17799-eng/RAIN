MATCH (c:Concept {concept_id: 'C-PROVIDER'}), (f:SourceField {name: 'assigned_provider_id', source_system: 'PregnancyEpisode'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'needs-review', r.note = 'Provider attribution under another column name; 0 episodes point at the deactivated providers.';
MERGE (s_23807:SourceSystem {name: 'Patient'}) MERGE (f_RAIN_24269:SourceField {name: 'primary_provider_id', source_system: 'Patient'}) MERGE (f_RAIN_24269)-[:BELONGS_TO]->(s_23807);
MATCH (c:Concept {concept_id: 'C-PROVIDER'}), (f:SourceField {name: 'primary_provider_id', source_system: 'Patient'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'needs-review', r.note = 'Provider attribution under another column name. Never PRV-001/002; differs from the enrollment assignment for all 49 affected patients.';
MERGE (s_33038:SourceSystem {name: 'Provider'}) MERGE (f_RAIN_7122:SourceField {name: 'reassigned_to_provider_id', source_system: 'Provider'}) MERGE (f_RAIN_7122)-[:BELONGS_TO]->(s_33038);
MATCH (c:Concept {concept_id: 'C-PROVIDER'}), (f:SourceField {name: 'reassigned_to_provider_id', source_system: 'Provider'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'needs-review', r.note = 'Self-reference to the successor provider (PRV-001->PRV-010, PRV-002->PRV-011). Successor specialties look swapped; verify before use.';
MERGE (s_23807:SourceSystem {name: 'Patient'}) MERGE (f_RAIN_50376:SourceField {name: 'connectivity_status', source_system: 'Patient'}) MERGE (f_RAIN_50376)-[:BELONGS_TO]->(s_23807);
MATCH (c:Concept {concept_id: 'C-ACCESS-BARRIER'}), (f:SourceField {name: 'connectivity_status', source_system: 'Patient'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'auto-eligible', r.note = 'Patient-level connectivity barrier (dead-zone 574 / connected 889); same meaning as ConnectivityRegistry.broadband_available. RPM received: 47.3% vs 89.5%.';

