// --- Duplicate/overlap candidates ---
MATCH (a:Concept {concept_id: 'C-EPISODE'}), (b:Concept {concept_id: 'C-RISK-SIGNAL'}) MERGE (a)-[r:OVERLAPS]->(b) SET r.overlap_category = 'low-overlap', r.resolution = 'not a duplicate -- distinct concepts, kept separate';

// --- Coverage gaps detected ---
CREATE (gap0:CoverageGap {domain: 'RAIN', description: 'A constituent can hold both an Episode (pregnancy) and a separate Episode (chronic condition) with no explicit link between them, even though both trace to the same person.', impact: 'Cross-episode risk questions (e.g. \'pregnancy risk cross-referenced with chronic conditions\') return incomplete results without an explicit join concept.', recommendation: 'Add a \'Compounding Risk\' relationship type between two Episode nodes sharing a Constituent, rather than relying on the calling application to infer it.', status: 'human-review-pending'});
MATCH (g:CoverageGap {domain: 'RAIN', status: 'human-review-pending'}), (c:Concept {concept_id: 'C-EPISODE'}) MERGE (g)-[:AFFECTS]->(c);
CREATE (gap1:CoverageGap {domain: 'USSFCU', description: 'The signature USSFCU use case (\'how many members carry a specific set of characteristics\') requires joining age + geography (Core) with loan pricing (MeridianLink) with a protected-basis determination -- but no single source field represents \'protected basis assessment.\' It only exists as a computed', impact: 'Same shape of gap as the RAIN compounding-risk finding: a cross-source relationship the raw schema never states explicitly, that the calling application would otherwise have to infer on its own.', recommendation: 'Add an explicit \'Regulatory Test Result\' relationship connecting Constituent + Regulatory Test + the source records it was evaluated against, rather than leaving the join implicit.', status: 'human-review-pending'});
MATCH (g:CoverageGap {domain: 'USSFCU', status: 'human-review-pending'}), (c:Concept {concept_id: 'C-REGULATORY-TEST'}) MERGE (g)-[:AFFECTS]->(c);
