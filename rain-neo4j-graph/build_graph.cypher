MERGE (s_35897:SourceSystem {name: 'Jack Henry / Symitar (Core)'}) MERGE (f_USSFCU_18133:SourceField {name: 'member_id', source_system: 'Jack Henry / Symitar (Core)'}) MERGE (f_USSFCU_18133)-[:BELONGS_TO]->(s_35897);
MATCH (c:Concept {concept_id: 'C-CONSTITUENT'}), (f:SourceField {name: 'member_id', source_system: 'Jack Henry / Symitar (Core)'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'USSFCU', r.confidence_category = 'auto-eligible', r.note = 'RESOLVED FINDING: this run originally proposed a new \'Constituent\' concept here, flagged for human review because it structurally duplicated C-PATIENT without being the same real-world thing. That rev';
MERGE (s_53177:SourceSystem {name: 'Medallia'}) MERGE (f_USSFCU_53010:SourceField {name: 'member_id', source_system: 'Medallia'}) MERGE (f_USSFCU_53010)-[:BELONGS_TO]->(s_53177);
MATCH (c:Concept {concept_id: 'C-CONSTITUENT'}), (f:SourceField {name: 'member_id', source_system: 'Medallia'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'USSFCU', r.confidence_category = 'auto-eligible', r.note = 'RESOLVED FINDING: this run originally proposed a new \'Constituent\' concept here, flagged for human review because it structurally duplicated C-PATIENT without being the same real-world thing. That rev';
MERGE (s_2357:SourceSystem {name: 'HUNA'}) MERGE (f_USSFCU_91482:SourceField {name: 'application_id', source_system: 'HUNA'}) MERGE (f_USSFCU_91482)-[:BELONGS_TO]->(s_2357);
MATCH (c:Concept {concept_id: 'C-EPISODE'}), (f:SourceField {name: 'application_id', source_system: 'HUNA'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'USSFCU', r.confidence_category = 'auto-eligible', r.note = 'RESOLVED FINDING: this concept was C-CARE-EPISODE at the time of this run, and was held to needs-review purely because of the name (same class of bias as C-PATIENT), even though the structural fit to ';
MERGE (s_84179:SourceSystem {name: 'MeridianLink'}) MERGE (f_USSFCU_41957:SourceField {name: 'origination_id', source_system: 'MeridianLink'}) MERGE (f_USSFCU_41957)-[:BELONGS_TO]->(s_84179);
MATCH (c:Concept {concept_id: 'C-EPISODE'}), (f:SourceField {name: 'origination_id', source_system: 'MeridianLink'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'USSFCU', r.confidence_category = 'auto-eligible', r.note = 'RESOLVED FINDING: this concept was C-CARE-EPISODE at the time of this run, and was held to needs-review purely because of the name (same class of bias as C-PATIENT), even though the structural fit to ';
MERGE (s_84179:SourceSystem {name: 'MeridianLink'}) MERGE (f_USSFCU_60944:SourceField {name: 'fair_lending_disparity_index', source_system: 'MeridianLink'}) MERGE (f_USSFCU_60944)-[:BELONGS_TO]->(s_84179);
MATCH (c:Concept {concept_id: 'C-RISK-SIGNAL'}), (f:SourceField {name: 'fair_lending_disparity_index', source_system: 'MeridianLink'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'USSFCU', r.confidence_category = 'auto-eligible', r.note = 'Clean fit -- the definition itself was never healthcare-specific, so this one genuinely generalizes. Rewritten in structured System.field form (was prose before) so it actually produces a graph edge i';
MERGE (s_84179:SourceSystem {name: 'MeridianLink'}) MERGE (f_USSFCU_82532:SourceField {name: 'trid_ontime_disclosure_rate', source_system: 'MeridianLink'}) MERGE (f_USSFCU_82532)-[:BELONGS_TO]->(s_84179);
