// ============================================================
// Data Factory upper-ontology knowledge graph
// Generated from 2 independent domain tests: RAIN, USSFCU
// Multiple unrelated domains sharing one concept layer -- proves the
// skill's output is genuinely cross-domain, not just claimed to be.
// ============================================================

CREATE CONSTRAINT concept_id_unique IF NOT EXISTS FOR (c:Concept) REQUIRE c.concept_id IS UNIQUE;
CREATE CONSTRAINT source_system_name_unique IF NOT EXISTS FOR (s:SourceSystem) REQUIRE s.name IS UNIQUE;

// --- Concepts (the shared upper ontology) ---
MERGE (cC_CONSTITUENT:Concept {concept_id: 'C-CONSTITUENT'}) SET cC_CONSTITUENT.name = 'Constituent', cC_CONSTITUENT.definition = 'The person or entity the whole system is organized around, tracked across any clinical, claims, financial, or operational system. Domain-specific systems may label this \'Patient\' (healthcare), \'Member\' (financial services), etc. -- those are specializations of this one concept, not separate concepts.', cC_CONSTITUENT.status = 'approved';
MERGE (cC_PROVIDER:Concept {concept_id: 'C-PROVIDER'}) SET cC_PROVIDER.name = 'Provider', cC_PROVIDER.definition = 'A clinician or care team member responsible for a patient\'s care.', cC_PROVIDER.status = 'approved';
MERGE (cC_EPISODE:Concept {concept_id: 'C-EPISODE'}) SET cC_EPISODE.name = 'Episode', cC_EPISODE.definition = 'A bounded period tied to a specific event or product for a constituent -- a pregnancy, a chronic-condition enrollment, a loan origination, a mortgage application-to-closing cycle.', cC_EPISODE.status = 'approved';
MERGE (cC_RISK_SIGNAL:Concept {concept_id: 'C-RISK-SIGNAL'}) SET cC_RISK_SIGNAL.name = 'Risk Signal', cC_RISK_SIGNAL.definition = 'A computed or observed indicator that a patient\'s risk has changed (an RPM reading trend, a missed visit, a lab overdue).', cC_RISK_SIGNAL.status = 'approved';
MERGE (cC_ACCESS_BARRIER:Concept {concept_id: 'C-ACCESS-BARRIER'}) SET cC_ACCESS_BARRIER.name = 'Access Barrier', cC_ACCESS_BARRIER.definition = 'A structural obstacle to care -- distance, transportation, connectivity, or provider availability.', cC_ACCESS_BARRIER.status = 'approved';
MERGE (cC_REGULATORY_TEST:Concept {concept_id: 'C-REGULATORY-TEST'}) SET cC_REGULATORY_TEST.name = 'Regulatory Test', cC_REGULATORY_TEST.definition = 'A codified compliance check applied against a population or record (e.g. TRID, ECOA, ESIGN, GLBA).', cC_REGULATORY_TEST.status = 'proposed', cC_REGULATORY_TEST.proposed_by_domain = 'USSFCU';
MERGE (cC_COMPLAINT:Concept {concept_id: 'C-COMPLAINT'}) SET cC_COMPLAINT.name = 'Complaint', cC_COMPLAINT.definition = 'A recorded or inferred expression of dissatisfaction from the person being served.', cC_COMPLAINT.status = 'proposed', cC_COMPLAINT.proposed_by_domain = 'USSFCU';

// --- Source systems + fields + MAPS_TO edges (RAIN domain) ---
MERGE (s_23807:SourceSystem {name: 'Patient'}) MERGE (f_RAIN_89184:SourceField {name: 'patient_id', source_system: 'Patient'}) MERGE (f_RAIN_89184)-[:BELONGS_TO]->(s_23807);
MATCH (c:Concept {concept_id: 'C-CONSTITUENT'}), (f:SourceField {name: 'patient_id', source_system: 'Patient'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'auto-eligible', r.note = '';
MERGE (s_85579:SourceSystem {name: 'PregnancyEpisode'}) MERGE (f_RAIN_6634:SourceField {name: 'patient_id', source_system: 'PregnancyEpisode'}) MERGE (f_RAIN_6634)-[:BELONGS_TO]->(s_85579);
