MATCH (c:Concept {concept_id: 'C-REGULATORY-TEST'}), (f:SourceField {name: 'rule_id / test_definition', source_system: 'Regulatory Rules Engine'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'USSFCU', r.confidence_category = 'auto-eligible', r.note = 'Genuinely new -- no equivalent existed in the ontology before this run. Clean, unambiguous addition.';
MERGE (s_13763:SourceSystem {name: 'SharePoint'}) MERGE (f_USSFCU_69255:SourceField {name: 'complaint_id', source_system: 'SharePoint'}) MERGE (f_USSFCU_69255)-[:BELONGS_TO]->(s_13763);
MATCH (c:Concept {concept_id: 'C-COMPLAINT'}), (f:SourceField {name: 'complaint_id', source_system: 'SharePoint'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'USSFCU', r.confidence_category = 'needs-review', r.note = 'Overlaps partially with C-RISK-SIGNAL (a complaint IS a kind of risk signal). Is this a subtype of Risk Signal or a sibling concept? Left for a human to decide rather than guessed.';
