MERGE (s_33038:SourceSystem {name: 'Provider'}) MERGE (f_RAIN_32256:SourceField {name: 'provider_id', source_system: 'Provider'}) MERGE (f_RAIN_32256)-[:BELONGS_TO]->(s_33038);
MATCH (c:Concept {concept_id: 'C-PROVIDER'}), (f:SourceField {name: 'provider_id', source_system: 'Provider'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'auto-eligible', r.note = '';
MERGE (s_68921:SourceSystem {name: 'ClaimEncounter'}) MERGE (f_RAIN_34222:SourceField {name: 'rendering_provider_id', source_system: 'ClaimEncounter'}) MERGE (f_RAIN_34222)-[:BELONGS_TO]->(s_68921);
MATCH (c:Concept {concept_id: 'C-PROVIDER'}), (f:SourceField {name: 'rendering_provider_id', source_system: 'ClaimEncounter'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'needs-review', r.note = 'field name genuinely differs from Provider.provider_id in the real generated data -- flagged, not auto-merged';
MERGE (s_85579:SourceSystem {name: 'PregnancyEpisode'}) MERGE (f_RAIN_60099:SourceField {name: 'episode_id', source_system: 'PregnancyEpisode'}) MERGE (f_RAIN_60099)-[:BELONGS_TO]->(s_85579);
MATCH (c:Concept {concept_id: 'C-EPISODE'}), (f:SourceField {name: 'episode_id', source_system: 'PregnancyEpisode'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'auto-eligible', r.note = '';
MERGE (s_99409:SourceSystem {name: 'ChronicConditionEnrollment'}) MERGE (f_RAIN_66603:SourceField {name: 'enrollment_id', source_system: 'ChronicConditionEnrollment'}) MERGE (f_RAIN_66603)-[:BELONGS_TO]->(s_99409);
MATCH (c:Concept {concept_id: 'C-EPISODE'}), (f:SourceField {name: 'enrollment_id', source_system: 'ChronicConditionEnrollment'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'needs-review', r.note = 'field name genuinely differs from PregnancyEpisode.episode_id in the real generated data -- same concept, different label, flagged for review';
MERGE (s_38533:SourceSystem {name: 'RPMReading'}) MERGE (f_RAIN_29078:SourceField {name: 'reading_type', source_system: 'RPMReading'}) MERGE (f_RAIN_29078)-[:BELONGS_TO]->(s_38533);
MATCH (c:Concept {concept_id: 'C-RISK-SIGNAL'}), (f:SourceField {name: 'reading_type', source_system: 'RPMReading'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'auto-eligible', r.note = '';
MERGE (s_68921:SourceSystem {name: 'ClaimEncounter'}) MERGE (f_RAIN_69859:SourceField {name: 'avoidable_ed_flag', source_system: 'ClaimEncounter'}) MERGE (f_RAIN_69859)-[:BELONGS_TO]->(s_68921);
MATCH (c:Concept {concept_id: 'C-RISK-SIGNAL'}), (f:SourceField {name: 'avoidable_ed_flag', source_system: 'ClaimEncounter'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'auto-eligible', r.note = '';
MERGE (s_57347:SourceSystem {name: 'SDOHFlag'}) MERGE (f_RAIN_46996:SourceField {name: 'flag_type', source_system: 'SDOHFlag'}) MERGE (f_RAIN_46996)-[:BELONGS_TO]->(s_57347);
MATCH (c:Concept {concept_id: 'C-ACCESS-BARRIER'}), (f:SourceField {name: 'flag_type', source_system: 'SDOHFlag'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'auto-eligible', r.note = '';
MERGE (s_24903:SourceSystem {name: 'ConnectivityRegistry'}) MERGE (f_RAIN_27263:SourceField {name: 'broadband_available', source_system: 'ConnectivityRegistry'}) MERGE (f_RAIN_27263)-[:BELONGS_TO]->(s_24903);
MATCH (c:Concept {concept_id: 'C-ACCESS-BARRIER'}), (f:SourceField {name: 'broadband_available', source_system: 'ConnectivityRegistry'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'RAIN', r.confidence_category = 'auto-eligible', r.note = '';

