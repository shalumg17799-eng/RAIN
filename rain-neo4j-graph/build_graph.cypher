MERGE (s_53177:SourceSystem {name: 'Medallia'}) MERGE (f_USSFCU_70087:SourceField {name: 'complaint_trend_qoq', source_system: 'Medallia'}) MERGE (f_USSFCU_70087)-[:BELONGS_TO]->(s_53177);
MATCH (c:Concept {concept_id: 'C-RISK-SIGNAL'}), (f:SourceField {name: 'complaint_trend_qoq', source_system: 'Medallia'}) MERGE (c)-[r:MAPS_TO]->(f) SET r.domain = 'USSFCU', r.confidence_category = 'auto-eligible', r.note = 'Clean fit -- the definition itself was never healthcare-specific, so this one genuinely generalizes. Rewritten in structured System.field form (was prose before) so it actually produces a graph edge i';
