// =====================================================================================================
// RAIN v0.4 knowledge graph (KAG) - persona and lineage queries for Neo4j Browser
// Open http://localhost:17477/browser/ , connect URL bolt://localhost:17690 , user neo4j / password, database neo4j.
// Release 'rain-v4.1.0' is the only content of the database: the PRD v0.4 seed (7 personas, signals, steps, success
// metrics), the UI workbenches with persona access, every table of rain_v4 (synthetic,
// public_data, ui_v4) with columns, keys and row counts, the data sources with load status, the computed metric
// groups and datasets, the persona query pack and the write-back flows.
// Generated by scripts/e2e/kag_v4_refresh.py (checks: doc/queries/RAIN_v4_kag_check.md).
// =====================================================================================================

// @id KAG-1  The seven v0.4 personas: origin, scope, UI id and status, workbenches, pack queries
MATCH (p:Persona {release: 'rain-v4.1.0'})
RETURN p.order AS order, p.name AS name, p.role AS role, p.prd_origin AS prd_origin, p.data_scope AS data_scope,
       p.persona_id AS kag_id, p.ui_persona_id AS ui_id, p.ui_status AS ui_status, p.workbench_count AS workbenches, p.queries AS queries
ORDER BY p.order;

// @id KAG-2  Every persona with everything it links to (graph view)
MATCH (p:Persona {release: 'rain-v4.1.0'})-[r]->(x)
WHERE NOT x:Query
RETURN p, r, x;

// @id KAG-3  One persona's neighbourhood (swap the id: rain_ceo, rain_cmo, rain_cio, rain_state, rain_chw, rain_access,
//            patient_linda_garcia)
MATCH (p:Persona {release: 'rain-v4.1.0', persona_id: 'rain_ceo'})-[r]-(x)
RETURN p, r, x;

// @id KAG-4  Priority signals per persona (PRD)
MATCH (p:Persona {release: 'rain-v4.1.0'})-[:HAS_SIGNAL]->(s:Signal)
RETURN p.name AS persona, s.name AS signal, s.severity AS severity, s.detail AS detail
ORDER BY p.order, s.severity;

// @id KAG-5  The PRD's suggested questions and the UI's chat suggestions per persona
MATCH (p:Persona {release: 'rain-v4.1.0'})
RETURN p.name AS persona, coalesce(p.suggested_queries, []) AS prd_questions, coalesce(p.ui_suggested_queries, []) AS ui_questions
ORDER BY p.order;

// @id KAG-6  Guided conversation steps per persona (PRD v0.3), in order
MATCH (p:Persona {release: 'rain-v4.1.0'})-[:HAS_STEP]->(s:Step)
RETURN p.name AS persona, s.step AS step, s.user_prompt AS user_prompt, s.visualization AS visualization
ORDER BY p.order, s.step;

// @id KAG-7  What each persona's workbenches read: Persona -> Workbench -> Class -> Table
MATCH (p:Persona {release: 'rain-v4.1.0'})-[u:USES]->(w:Workbench)-[:READS]->(c:Class)-[:MAPS_TO]->(t:Table)
RETURN p.name AS persona, w.name AS workbench, u.access AS access, u.scope AS scope,
       collect(DISTINCT c.name) AS classes, collect(DISTINCT t.qualified_name) AS tables
ORDER BY persona, workbench;

// @id KAG-8  Same lineage as a graph (one persona; swap the id)
MATCH path = (p:Persona {release: 'rain-v4.1.0', persona_id: 'rain_cmo'})-[:USES]->(:Workbench)-[:READS]->(:Class)-[:MAPS_TO]->(:Table)
RETURN path;

// @id KAG-9  The release without columns, queries and datasets (overview graph)
MATCH (n {release: 'rain-v4.1.0'})
WHERE NOT n:Column AND NOT n:Query AND NOT n:Dataset
OPTIONAL MATCH (n)-[r]->(m {release: 'rain-v4.1.0'})
WHERE NOT m:Column AND NOT m:Query AND NOT m:Dataset
RETURN n, r, m;

// @id KAG-10 Contract checkpoint the operator personas view
MATCH (p:Persona {release: 'rain-v4.1.0'})-[:VIEWS]->(c:Checkpoint)
RETURN c.name AS checkpoint, c.actual_pmpm AS actual_pmpm, c.expected_pmpm AS expected_pmpm, c.days_left AS days_left, collect(p.name) AS viewed_by;

// @id KAG-11 Success metrics and the personas that own them (PRD v0.4 Section 10)
MATCH (p:Persona {release: 'rain-v4.1.0'})-[:OWNS_METRIC]->(m:SuccessMetric)
RETURN m.metric_id AS metric, m.name AS name, m.baseline AS baseline, m.target AS target, collect(p.name) AS owners
ORDER BY metric;

// @id KAG-12 The workbenches (UI ids and paths) and who uses them with what access
MATCH (w:Workbench {release: 'rain-v4.1.0'})
OPTIONAL MATCH (p:Persona)-[u:USES]->(w)
RETURN w.ui_id AS id, w.path AS path, w.name AS workbench, w.ui_priority AS priority,
       collect(p.name + ' (' + u.access + coalesce(', ' + u.scope, '') + ')') AS used_by
ORDER BY id;

// @id KAG-13 Each persona's pack queries and the tables they read
MATCH (p:Persona {release: 'rain-v4.1.0'})-[:ASKS]->(q:Query)-[:READS]->(t:Table)
RETURN p.order AS order, p.name AS persona, q.query_id AS query, q.data AS data, q.question AS question,
       collect(t.qualified_name) AS tables
ORDER BY order, query;

// @id KAG-14 Computed metric groups (rain-api/metrics_v4.py) and the tables they read
MATCH (m:MetricGroup {release: 'rain-v4.1.0'})
OPTIONAL MATCH (m)-[:COMPUTED_FROM]->(t:Table)
OPTIONAL MATCH (m)-[:DERIVED_FROM]->(src:MetricGroup)
RETURN m.kind AS kind, m.name AS group, m.description AS description,
       collect(DISTINCT t.qualified_name) AS tables, collect(DISTINCT src.name) AS built_from
ORDER BY kind, group;

// @id KAG-15 Datasets the UI renders: dataset -> metric groups -> tables, and who sees them
MATCH (d:Dataset {release: 'rain-v4.1.0'})
OPTIONAL MATCH (d)-[:DERIVED_FROM]->(m:MetricGroup)
OPTIONAL MATCH (p:Persona)-[:SEES]->(d)
RETURN d.name AS dataset, d.caption AS caption, collect(DISTINCT m.name) AS groups, collect(DISTINCT p.name) AS seen_by
ORDER BY dataset;

// @id KAG-16 Write-back flows (/api/v4/flow/*): what they write and read, and which UI triggers them
MATCH (f:Flow {release: 'rain-v4.1.0'})
OPTIONAL MATCH (ui)-[:TRIGGERS]->(f)
RETURN f.path AS endpoint, f.method AS method, f.description AS does, f.writes AS writes, f.reads AS reads,
       collect(DISTINCT coalesce(ui.ui_id, ui.name)) AS triggered_from
ORDER BY endpoint;

// @id KAG-17 Data sources with load status (blocked ones say why) and the tables they load
MATCH (s:DataSource {release: 'rain-v4.1.0'})
OPTIONAL MATCH (s)-[:LOADS|FEEDS]->(t:Table)
RETURN s.kind AS kind, s.name AS source, s.load_status AS status, s.blocked_reason AS why_blocked, s.record_count AS records,
       collect(t.qualified_name) AS tables
ORDER BY kind, status, source;

// @id KAG-18 Table inventory: schema, rows, columns, PRD plan, extension flags, origin, source feed
MATCH (t:Table {release: 'rain-v4.1.0'})
RETURN t.schema AS schema, t.name AS table, t.row_count AS rows, t.column_count AS columns,
       t.planned_in_prd AS planned, t.extension_table AS extension_table, t.extension_columns AS extension_columns,
       t.origin AS origin, t.source_feed AS feed, t.write_back AS write_back
ORDER BY schema, table;

// @id KAG-19 Foreign keys (column to column)
MATCH (a:Table {release: 'rain-v4.1.0'})-[:HAS_COLUMN]->(c:Column)-[r:REFERENCES]->(d:Column)<-[:HAS_COLUMN]-(b:Table)
RETURN a.qualified_name AS table, c.name AS column, b.qualified_name AS references, d.name AS ref_column, r.constraint AS constraint
ORDER BY table, column;

// @id KAG-20 Synthetic reference tables derived from public data
MATCH (s:Table {release: 'rain-v4.1.0'})-[:DERIVED_FROM]->(p:Table)
OPTIONAL MATCH (src:DataSource)-[:LOADS]->(p)
RETURN s.qualified_name AS synthetic_table, collect(DISTINCT p.qualified_name) AS from_public, collect(DISTINCT src.name) AS sources;

// @id KAG-21 Impact of a table: which queries, metric groups, flows and personas depend on it (swap the table)
MATCH (t:Table {release: 'rain-v4.1.0', qualified_name: 'synthetic.appointment'})
OPTIONAL MATCH (q:Query)-[:READS]->(t) OPTIONAL MATCH (pq:Persona)-[:ASKS]->(q)
OPTIONAL MATCH (m:MetricGroup)-[:COMPUTED_FROM]->(t) OPTIONAL MATCH (pm:Persona)-[:SEES]->(m)
OPTIONAL MATCH (f:Flow)-[:WRITES]->(t)
RETURN t.qualified_name AS table, collect(DISTINCT q.query_id) AS queries, collect(DISTINCT m.name) AS metric_groups,
       collect(DISTINCT f.name) AS written_by, collect(DISTINCT coalesce(pq.name, pm.name)) AS personas;

// @id KAG-22 The release node (what it was built from)
MATCH (r:Release {release: 'rain-v4.1.0'}) RETURN r.name AS release, r.built_at AS built_at, r.git_commit AS git, r.sources AS sources;
